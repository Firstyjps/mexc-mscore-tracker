{
  "manifest_version": 3,
  "name": "MEXC M-Score Tracker",
  "version": "1.1.0",
  "description": "เก็บและดูประวัติ M-Score ของ MEXC ข้อมูลอยู่ในเครื่องคุณเท่านั้น ไม่ส่งออกไปที่ไหน",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.mexc.com/*", "https://www.mexc.co/*", "https://www.mexc.fm/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "เปิด M-Score Tracker",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
